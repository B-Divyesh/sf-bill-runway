{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.{css,js,png,jpg,svg,webp,ico,woff2,json,webmanifest,txt,xml,wasm}"
    ]
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.sociobot.in https://pilot-api.sociobot.in; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "routes": [
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "public, must-revalidate, max-age=30",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "route": "/manifest.webmanifest",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    }
  ]
}
